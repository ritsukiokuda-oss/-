# ===== 共通 =====
ANTHROPIC_API_KEY=            # ネタ・チェック・分析担当（Claude）
CLAUDE_MODEL=claude-opus-5-5

# 動画生成: mock / kling / veo / runway
VIDEO_PROVIDER=kling
VIDEO_SECONDS=8               # 1本あたりの秒数（コストに直結）

# ===== Kling（新方式: APIキー1つだけ） =====
# https://kling.ai/dev/api-key で発行
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-3.0         # kling-3.0 / kling-3.0-turbo（音声付き） / kling-2.6（安い）
KLING_RESOLUTION=720p         # 720p / 1080p / 4k
KLING_AUDIO=off               # off / native（鳴き声・効果音を自動生成。料金1.5倍）

# ===== Google Veo (Gemini API) =====
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview   # 公式ドキュメントで最新のモデル名を確認してください

# ===== Runway =====
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5

# ===== Instagram (Graph API) =====
IG_USER_ID=                   # Instagram プロアカウントのID
IG_ACCESS_TOKEN=              # 長期アクセストークン
IG_GRAPH_HOST=https://graph.facebook.com
IG_API_VERSION=v23.0

# チェック担当の合格ライン（0〜100）と、不合格時の作り直し回数
CHECK_PASS_SCORE=75
MAX_RETRIES=2
